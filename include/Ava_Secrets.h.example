#ifndef AVA_SECRETS_H_EXAMPLE
#define AVA_SECRETS_H_EXAMPLE

// OpenRouter configuration is stored persistently in ESP32 NVS.
// Do NOT put the real API key in firmware source code.
//
// One-time provisioning through Serial Monitor:
// apikey|YOUR_OPENROUTER_KEY
//
// OTA firmware updates do not erase this NVS value.

#define AVA_OPENROUTER_MODEL "openrouter/free"

#endif
